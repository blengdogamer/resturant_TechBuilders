rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email is string
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()) )
          && get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role == 'admin')
        || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isEmployee() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'employee'
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    function employeeHas(permission) {
      return isEmployee()
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.permissions is list
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.permissions.hasAny([permission]);
    }

    function validGuestOrder(orderId) {
      let day = request.resource.data.counterDate;
      let sequence = request.resource.data.counterValue;
      let counter = getAfter(/databases/$(database)/documents/dailyCounters/$(day));
      return isGuest()
        && request.resource.data.keys().hasAll([
          'orderNumber', 'phone', 'items', 'subtotal', 'taxes', 'taxTotal', 'total', 'currency',
          'serviceType', 'paymentMethod', 'payment', 'status', 'customerUid', 'counterDate', 'counterValue', 'location', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderNumber', 'phone', 'items', 'subtotal', 'taxes', 'taxTotal', 'total', 'currency',
          'serviceType', 'paymentMethod', 'payment', 'status', 'customerUid', 'counterDate', 'counterValue', 'location', 'createdAt'
        ])
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.matches('^[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]+$')
        && day is string && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && sequence is int && sequence > 0
        // Firestore Rules لا تدعم String.substring؛ نتحقق من تنسيق رقم الطلب والعداد بشكل منفصل.
        && counter.data.count == sequence
        && counter.data.lastOrderId == orderId
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 24
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0
        && request.resource.data.taxes is list
        && request.resource.data.taxTotal is number && request.resource.data.taxTotal >= 0
        && request.resource.data.total is number && request.resource.data.total >= request.resource.data.subtotal
        && request.resource.data.currency is string && request.resource.data.currency.size() <= 12
        && request.resource.data.serviceType in ['dineIn', 'takeaway']
        && request.resource.data.paymentMethod in ['cash', 'shamcash']
        && request.resource.data.payment is map
        && request.resource.data.payment.method == request.resource.data.paymentMethod
        && ((request.resource.data.paymentMethod == 'cash' && request.resource.data.payment.status == 'unpaid')
          || (request.resource.data.paymentMethod == 'shamcash' && request.resource.data.payment.status == 'pending_invoice'))
        && request.resource.data.status == 'pending'
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.location is map
        && request.resource.data.location.latitude is number
        && request.resource.data.location.latitude >= -90 && request.resource.data.location.latitude <= 90
        && request.resource.data.location.longitude is number
        && request.resource.data.location.longitude >= -180 && request.resource.data.location.longitude <= 180
        && request.resource.data.location.accuracy is number
        && request.resource.data.location.accuracy >= 0 && request.resource.data.location.accuracy <= 250
        && request.resource.data.location.distanceMeters is number
        && request.resource.data.location.distanceMeters >= 0 && request.resource.data.location.distanceMeters <= 500
        && request.resource.data.location.checkedAt is string
        && request.resource.data.createdAt == request.time;
    }

    match /admins/{emailOrUid} {
      allow get: if signedIn() && (
        (request.auth.token.email is string && emailOrUid == request.auth.token.email.lower())
        || emailOrUid == request.auth.uid
      );
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /staff/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'restaurant';
      allow write: if isAdmin();
    }

    match /dailyCounters/{day} {
      allow get: if isGuest();
      allow list: if false;
      allow create: if isGuest()
        && request.resource.data.keys().hasOnly(['date', 'count', 'lastOrderId', 'updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.count == 1
        && request.resource.data.lastOrderId is string
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.counterDate == day
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.counterValue == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if isGuest()
        && request.resource.data.keys().hasOnly(['date', 'count', 'lastOrderId', 'updatedAt'])
        && request.resource.data.date == day
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.lastOrderId is string
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.counterDate == day
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.counterValue == request.resource.data.count
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /menuGroups/{groupId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /menuItems/{itemId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || employeeHas('orders');
      allow get: if isAdmin() || employeeHas('orders') || (isGuest() && resource.data.customerUid == request.auth.uid);
      allow create: if validGuestOrder(orderId);
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'updatedAt', 'items', 'serviceType', 'subtotal', 'taxes', 'taxTotal', 'total', 'currency', 'payment'
          ])
          && request.resource.data.status in ['pending', 'accepted', 'preparing', 'ready', 'completed', 'cancelled'])
        || (isGuest() && resource.data.customerUid == request.auth.uid
          && resource.data.status == 'pending'
          && resource.data.paymentMethod == 'shamcash'
          && resource.data.payment.status == 'pending_invoice'
          && request.resource.data.payment.method == 'shamcash'
          && request.resource.data.payment.status == 'awaiting_payment'
          && request.resource.data.payment.invoiceId is string
          && request.resource.data.payment.paymentUrl is string
          && request.resource.data.payment.paymentUrl.matches('^https://.*$')
          && request.resource.data.payment.paymentNote is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment']))
        || (employeeHas('orders')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['pending', 'accepted', 'preparing', 'ready', 'completed', 'cancelled']);
      allow delete: if isAdmin()
        || (isGuest()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status == 'pending'
          && resource.data.payment.method == 'shamcash'
          && resource.data.payment.status in ['pending_invoice', 'awaiting_payment', 'expired', 'cancelled'])
        || (employeeHas('orders')
          && getAfter(/databases/$(database)/documents/orderArchive/$(orderId)).data.status == 'completed'
          && getAfter(/databases/$(database)/documents/orderArchive/$(orderId)).data.orderNumber == resource.data.orderNumber);
    }

    match /orderArchive/{orderId} {
      allow read: if isAdmin() || employeeHas('archive') || employeeHas('orders');
      allow create: if isAdmin() || (employeeHas('orders')
        && request.resource.data.status == 'completed'
        && get(/databases/$(database)/documents/orders/$(orderId)).data.orderNumber == request.resource.data.orderNumber);
      allow update: if isAdmin();
      allow delete: if isAdmin() || employeeHas('orders');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
